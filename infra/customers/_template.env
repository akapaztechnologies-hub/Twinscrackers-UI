# -----------------------------------------------------------------------------
# ONE CUSTOMER'S STOREFRONT (Cloudflare Pages)
#
# 1. Copy this file to  infra\customers\<customer>.env
# 2. Fill it in
# 3. From the frontend folder run:   .\infra\deploy.ps1 <customer>
#
# <customer>.env files are gitignored: they hold the customer's Cloudflare
# login. Never commit one, and never paste it into a chat.
# -----------------------------------------------------------------------------

# -- Cloudflare (the customer's own account) ----------------------------------

# Cloudflare dashboard -> the account -> Account ID (right-hand side).
CLOUDFLARE_ACCOUNT_ID=
# In that account: My Profile -> API Tokens -> Create Token -> Custom token:
#   Account | Cloudflare Pages | Edit
#   Zone    | DNS              | Edit    (only when CUSTOM_DOMAIN is set)
#   Zone    | Zone             | Read    (only when CUSTOM_DOMAIN is set)
CLOUDFLARE_API_TOKEN=
# Names the site and its free address: <PAGES_PROJECT>.pages.dev
PAGES_PROJECT=
# The customer's own address, e.g. sritharcrackers.com or www.sritharcrackers.com.
# Its DNS must already be in this Cloudflare account. Blank = pages.dev only.
CUSTOM_DOMAIN=
# The domain as Cloudflare lists it, when CUSTOM_DOMAIN is a sub-address
# (www.sritharcrackers.com -> sritharcrackers.com). Blank = same as CUSTOM_DOMAIN.
CLOUDFLARE_ZONE=

# -- Where Terraform keeps its notes ------------------------------------------
# The customer's Google Cloud project and account from the backend setup.
GCP_PROJECT_ID=
GCP_ACCOUNT=

# -- Website settings (built into the site) -----------------------------------

# The backend address the backend deploy printed, plus /api.
VITE_API_URL=
# The site's own public address, no trailing slash (the custom domain once connected).
VITE_SITE_URL=
VITE_SITE_NAME=
VITE_SITE_TAGLINE=
VITE_SITE_DESCRIPTION=
VITE_SITE_LOGO=/logo.png
VITE_THEME_COLOR=#0A0A0A
VITE_SITE_LOCALITY=
VITE_SITE_REGION=
VITE_SITE_REGION_CODE=

# Razorpay's public key id (the secret stays on the backend).
VITE_RAZORPAY_KEY_ID=

# Firebase web app, for Google sign-in (Firebase console -> Project settings -> Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
